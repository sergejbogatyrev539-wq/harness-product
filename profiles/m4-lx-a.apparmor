abi <abi/4.0>,
#include <tunables/global>

# Disposable M4 observer and publisher domains.  The outer trusted supervisor
# creates the mount/user/cgroup namespaces and exact FDs before either profile
# starts.  Neither domain can transition to another profile or create a route.

profile harness-m4-lx-a.observer flags=(mediate_deleted) {
  signal,
  / r,
  /usr/bin/python3.12 mrix,
  /usr/bin/openssl ix,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /etc/ld.so.cache r,
  /etc/harness-m4/runtime-trust.json r,
  /inputs/m4-role.json r,
  /opt/harness-m3-source/src/ r,
  /opt/harness-m3-source/src/harness_product/ r,
  /opt/harness-m3-source/src/harness_product/** r,
  /usr/lib/harness/worker-tool r,
  /proc/ r,
  /proc/*/ r,
  /proc/*/attr/current r,
  /proc/*/fd/ r,
  /proc/*/fd/* r,
  /var/lib/harness-m4-keys/observer/ r,
  /var/lib/harness-m4-keys/observer/public.pem r,
  /var/lib/harness-m4-keys/observer/private.pem r,
  /var/lib/harness-m4-keys/public/ r,
  /var/lib/harness-m4-keys/public/** r,
  /var/lib/harness-m3-attestor/public.pem r,

  audit deny /var/lib/harness-m4-publication/** rwkl,
  audit deny /staging/** rwkl,
  audit deny capability,
  audit deny network,
  audit deny mount,
  audit deny pivot_root,
  audit deny ptrace,
  audit deny change_profile,
}

profile harness-m4-lx-a.publisher flags=(mediate_deleted) {
  signal,
  / r,
  /usr/bin/python3.12 mrix,
  /usr/bin/openssl ix,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /etc/ld.so.cache r,
  /etc/harness-m4/runtime-trust.json r,
  /inputs/m4-role.json r,
  /opt/harness-m3-source/src/ r,
  /opt/harness-m3-source/src/harness_product/ r,
  /opt/harness-m3-source/src/harness_product/** r,
  /usr/lib/harness/worker-tool r,
  /proc/ r,
  /proc/*/ r,
  /proc/*/attr/current r,
  /proc/*/fd/ r,
  /proc/*/fd/* r,
  /proc/*/fdinfo/* r,
  /proc/*/mountinfo r,
  /proc/*/ns/mnt r,
  /var/lib/harness-m4-keys/publisher/ r,
  /var/lib/harness-m4-keys/publisher/public.pem r,
  /var/lib/harness-m4-keys/publisher/private.pem r,
  /var/lib/harness-m4-keys/public/ r,
  /var/lib/harness-m4-keys/public/** r,
  /var/lib/harness-m3-attestor/public.pem r,
  /var/lib/harness-m4-publication/anchor/publication/ rw,
  /var/lib/harness-m4-publication/anchor/publication/** rwk,
  audit deny /var/lib/harness-m4-publication/anchor/publication/.git/** rwkl,
  audit deny /staging/** rwkl,

  unix (getopt) type=seqpacket addr=none,
  unix (receive) type=seqpacket addr=none peer=(addr=none,label=unconfined),

  audit deny capability,
  audit deny network inet,
  audit deny network inet6,
  audit deny network netlink,
  audit deny network packet,
  audit deny mount,
  audit deny pivot_root,
  audit deny ptrace,
  audit deny change_profile,
}
