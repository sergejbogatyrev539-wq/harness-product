{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness:schema:loop-contract:2",
  "title": "Pre-approved bounded loop contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "contract_digest",
    "status",
    "principal",
    "audience",
    "authority_domain",
    "allowed_effects",
    "allowed_operations",
    "aggregate_budgets",
    "iteration_bound",
    "d2",
    "artifact_bindings",
    "postcheck",
    "human_confirmation",
    "lifecycle",
    "material_change_invalidates"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "contract_id": {"type": "string", "pattern": "^contract:[A-Za-z0-9][A-Za-z0-9._:/-]{0,119}$"},
    "contract_version": {"type": "integer", "minimum": 2},
    "contract_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["DRAFT", "ACTIVE", "EXPIRED", "REVOKED", "CONSUMED"]},
    "principal": {"$ref": "#/$defs/id"},
    "audience": {"$ref": "#/$defs/id"},
    "authority_domain": {"$ref": "#/$defs/authorityDomain"},
    "allowed_effects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/effect"}},
    "allowed_operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "aggregate_budgets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/budget"}},
    "iteration_bound": {"$ref": "#/$defs/iterationBound"},
    "d2": {"$ref": "#/$defs/d2"},
    "artifact_bindings": {"$ref": "#/$defs/artifactBindings"},
    "postcheck": {"$ref": "#/$defs/postcheck"},
    "human_confirmation": {"$ref": "#/$defs/humanConfirmation"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "material_change_invalidates": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"human_confirmation": {"properties": {"mode": {"const": "PER_CONTRACT_AGGREGATE"}}}, "status": {"const": "ACTIVE"}}, "required": ["human_confirmation", "status"]},
      "then": {"properties": {"human_confirmation": {"properties": {"receipt_digest": {"$ref": "#/$defs/digest"}}}}}
    },
    {
      "if": {"properties": {"human_confirmation": {"properties": {"mode": {"const": "NOT_REQUIRED"}}}}, "required": ["human_confirmation"]},
      "then": {"properties": {"human_confirmation": {"properties": {"receipt_digest": {"type": "null"}}}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "effect": {"enum": ["COMPUTE", "OBSERVE", "MUTATE", "COMMUNICATE", "DELEGATE", "REFLECT"]},
    "authorityDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_id", "definition_status", "journal_lineage_id"],
      "properties": {
        "domain_id": {"$ref": "#/$defs/id"},
        "definition_status": {"const": "PROVISIONAL"},
        "journal_lineage_id": {"$ref": "#/$defs/id"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "values"],
      "properties": {
        "kind": {"enum": ["PATH", "ENDPOINT", "PRINCIPAL", "MEMORY", "PROMPT", "POLICY", "PROCESS", "LOCAL_RESOURCE"]},
        "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "manifest_digest", "effects", "scopes", "approval_class"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{0,127}$"},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "effects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/effect"}},
        "scopes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scope"}},
        "approval_class": {"enum": ["NONE", "PREAUTHORIZED_EXACT", "HUMAN_SINGLE", "HUMAN_DUAL"]}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit", "limit", "scope", "reset", "scope_digest", "lineage_root"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
        "unit": {"enum": ["CALLS", "BYTES", "FILES", "MESSAGES", "AGENTS", "TOKENS", "MILLISECONDS", "CPU_MILLISECONDS", "MIB", "OPERATIONS"]},
        "limit": {"type": "integer", "minimum": 0},
        "scope": {"enum": ["CALL", "ITERATION", "SESSION", "CONTRACT", "LINEAGE", "DELEGATION_TREE"]},
        "reset": {"enum": ["NEVER", "NEW_SIGNED_CONTRACT"]},
        "scope_digest": {"$ref": "#/$defs/digest"},
        "lineage_root": {"$ref": "#/$defs/id"}
      }
    },
    "iterationBound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_iterations", "counter_source", "monotonic", "durable", "reset_on_restart", "reset_on_retry", "reset_on_nested_contract"],
      "properties": {
        "max_iterations": {"type": "integer", "minimum": 1},
        "success_target": {"type": "integer", "minimum": 1},
        "counter_source": {"const": "CANONICAL_DURABLE_JOURNAL"},
        "monotonic": {"const": true},
        "durable": {"const": true},
        "reset_on_restart": {"const": false},
        "reset_on_retry": {"const": false},
        "reset_on_nested_contract": {"const": false}
      }
    },
    "d2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_status", "operational_bound", "private_ephemeral_tokens_excluded"],
      "properties": {
        "definition_status": {"const": "PROVISIONAL"},
        "operational_bound": {"const": "NO_CONTROLLER_VISIBLE_PERSISTED_STAGED_TOOL_BOUND_BUDGETED_REUSABLE_BEYOND_ATTEMPT_CURSOR_PLUS_ONE"},
        "private_ephemeral_tokens_excluded": {"const": true}
      }
    },
    "artifactBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_digest", "registry_digest", "isolation_profile_digest", "prompt_digest", "context_digest", "model_digest", "toolset_digest"],
      "properties": {
        "policy_digest": {"$ref": "#/$defs/digest"},
        "registry_digest": {"$ref": "#/$defs/digest"},
        "isolation_profile_digest": {"$ref": "#/$defs/digest"},
        "prompt_digest": {"$ref": "#/$defs/digest"},
        "context_digest": {"$ref": "#/$defs/digest"},
        "model_digest": {"$ref": "#/$defs/digest"},
        "toolset_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "postcheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_each_iteration", "plan_digest", "independent_observer", "failure_result"],
      "properties": {
        "required_each_iteration": {"const": true},
        "plan_digest": {"$ref": "#/$defs/digest"},
        "independent_observer": {"const": true},
        "failure_result": {"const": "STOPPED_NEW_TRANSACTION_REQUIRED"}
      }
    },
    "humanConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "receipt_digest", "machine_join_each_iteration", "may_expand_physical_ceiling"],
      "properties": {
        "mode": {"enum": ["NOT_REQUIRED", "PER_CONTRACT_AGGREGATE"]},
        "receipt_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "machine_join_each_iteration": {"const": true},
        "may_expand_physical_ceiling": {"const": false}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issued_at", "not_before", "expires_at", "revocation_epoch"],
      "properties": {
        "issued_at": {"type": "string", "format": "date-time"},
        "not_before": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "revocation_epoch": {"type": "integer", "minimum": 0}
      }
    }
  }
}
